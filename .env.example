# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Required for content-production wp_sites. Get from Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=


# ── Anthropic (Claude AI) ─────────────────
ANTHROPIC_API_KEY=

# ── Ahrefs (optional: Content Production → Extract from title)
# This app calls the Ahrefs REST API (api.ahrefs.com), NOT MCP. Use a normal API key from:
# https://app.ahrefs.com/account/api-keys
# Cursor/ChatGPT “MCP” keys or OAuth tokens for Ahrefs MCP will NOT work here — create a separate API key.
# Uses API units from your paid plan.
AHREFS_API_KEY=
# Keywords Explorer country (ISO 3166-1 alpha-2), default us
AHREFS_KEYWORD_COUNTRY=us

# ── Fathom ───────────────────────────────
FATHOM_API_KEY=
FATHOM_WEBHOOK_SECRET=

# ── Asana ─────────────────────────────────
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=
ASANA_WORKSPACE_GID=
# Optional: required if workspace is an organization. Get from project Settings > Team.
ASANA_TEAM_GID=
# Optional: for Priority custom field (Premium). Get GIDs from project custom field settings.
# IMPORTANT: The Priority field must be global to your workspace (add to org field library in Asana).
# If not global, the tool will auto-create a workspace-level Priority field for new projects.
ASANA_PRIORITY_FIELD_GID=
ASANA_PRIORITY_HIGH_GID=
ASANA_PRIORITY_MEDIUM_GID=
ASANA_PRIORITY_LOW_GID=
# Optional: for Status custom field when auto-creating projects.
ASANA_STATUS_FIELD_GID=
ASANA_STATUS_ON_TRACK_GID=

# ── Gmail OAuth ──────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Slack ────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Tool Access ───────────────────────────
TOOL_PASSWORD=

# ── Article Title Discovery ───────────────
OPENAI_API_KEY=
ARTICLE_SLACK_WEBHOOK_URL=

# ── Gemini (shared across all sites) ───────
GEMINI_API_KEY=
# Optional: image generation model. Default: gemini-2.5-flash-preview-image-generation
# If 404, try: gemini-2.0-flash-exp
# GEMINI_IMAGE_MODEL=
