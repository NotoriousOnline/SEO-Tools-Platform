# ── Server logs (/logs UI) ─────────────────
# Strong password for the in-app logs viewer. Requires app_logs table — run supabase/migrations/004_app_logs.sql
LOGS_VIEWER_PASSWORD=


# ── WordPress / WAF (optional) ────────────
# If Cloudflare returns 403 + “Just a moment…” for /wp-json/ from Vercel, Node cannot solve the browser
# challenge — infra must allowlist the app (recommended: cookie that matches a Cloudflare rule).
# Set on Vercel (same value your Cloudflare rule expects). Example name/value from infra:
# WORDPRESS_WAF_BYPASS_COOKIE=cf_bypass=YOUR_HEX_SECRET
# Other options (if your rule uses them instead):
# WORDPRESS_WAF_BYPASS_QUERY=bypass_key=SHARED_SECRET
# WORDPRESS_WAF_BYPASS_HEADER_NAME=X-Publisher-Secret
# WORDPRESS_WAF_BYPASS_HEADER_VALUE=SHARED_SECRET
# WORDPRESS_REST_USER_AGENT_SUFFIX=YourPublisher/1.0
# Alternative (no WAF secret): point REST calls to an unproxied WP origin/API subdomain:
# WORDPRESS_REST_BASE_URL=https://origin.example.com


# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Required for content-production wp_sites. Get from Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=


# ── Anthropic (Claude AI) ─────────────────
ANTHROPIC_API_KEY=

# ── Ahrefs (optional: Content Production → Extract from title)
# This app calls the Ahrefs REST API (api.ahrefs.com), NOT MCP. Use a normal API key from:
# https://app.ahrefs.com/account/api-keys
# Cursor/ChatGPT "MCP" keys or OAuth tokens for Ahrefs MCP will NOT work here — create a separate API key.
# Uses API units from your paid plan.
AHREFS_API_KEY=
# Keywords Explorer country (ISO 3166-1 alpha-2), default us
AHREFS_KEYWORD_COUNTRY=us

# ── Article Title Discovery ───────────────
OPENAI_API_KEY=
ARTICLE_SLACK_WEBHOOK_URL=

# ── Weed.com: Google Sheet article queue (optional; Weed tool loads rows from Sheets API)
# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# WEED_ARTICLE_SHEET_ID=
# Tab + range if not default first sheet (must match your doc). Quote sheet names with spaces:
# WEED_ARTICLE_SHEET_RANGE='Weed.com Learn Articles'!A1:J5000
# Recommended: create a Google Cloud service account, enable Sheets API, paste the full JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Then share the spreadsheet with the service account email (Viewer is enough).
# Alternative for a publicly readable sheet only:
# GOOGLE_SHEETS_API_KEY=

# ── Gemini (shared across all sites) ───────
GEMINI_API_KEY=
# Optional: image generation model. Default: gemini-2.5-flash-preview-image-generation
# If 404, try: gemini-2.0-flash-exp
# GEMINI_IMAGE_MODEL=
