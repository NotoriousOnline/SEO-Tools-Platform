# ── Server logs (/logs UI) ─────────────────
# Strong password for the in-app logs viewer. Requires app_logs table — run supabase/migrations/004_app_logs.sql
LOGS_VIEWER_PASSWORD=daniyal258@


# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Required for content-production wp_sites. Get from Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=


# ── Anthropic (Claude AI) ─────────────────
ANTHROPIC_API_KEY=

# ── Ahrefs (optional: Content Production → Extract from title)
# This app calls the Ahrefs REST API (api.ahrefs.com), NOT MCP. Use a normal API key from:
# https://app.ahrefs.com/account/api-keys
# Cursor/ChatGPT "MCP" keys or OAuth tokens for Ahrefs MCP will NOT work here — create a separate API key.
# Uses API units from your paid plan.
AHREFS_API_KEY=
# Keywords Explorer country (ISO 3166-1 alpha-2), default us
AHREFS_KEYWORD_COUNTRY=us

# ── Article Title Discovery ───────────────
OPENAI_API_KEY=
ARTICLE_SLACK_WEBHOOK_URL=

# ── Gemini (shared across all sites) ───────
GEMINI_API_KEY=
# Optional: image generation model. Default: gemini-2.5-flash-preview-image-generation
# If 404, try: gemini-2.0-flash-exp
# GEMINI_IMAGE_MODEL=
